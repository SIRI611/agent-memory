{
  "policy_version": "v0.1-admission",
  "jev_model": "typesafe-ai/jev",
  "answer_model": "deepseek-flash",
  "deepseek_budget_usd": 100,
  "answer_base_url": "https://api.deepseek.com/chat/completions",
  "thinking": {"type": "disabled"},
  "max_output_tokens": 1024,
  "judge_max_output_tokens": 512,
  "token_counter": "ceil_chars_div_4",
  "low_priority_threshold": 0.35,
  "pilot_size": 20,
  "max_low_priority_in_pilot": 12,
  "random_seed": 0,
  "weights": {
    "constraint": 0.35,
    "impact": 0.3,
    "stable": 0.2,
    "user_specific": 0.15
  },
  "keywords": [
    "allerg",
    "asthma",
    "diagnos",
    "pregnan",
    "medication",
    "medicine",
    "halal",
    "kosher",
    "vegan",
